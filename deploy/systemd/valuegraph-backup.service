# Nightly Postgres → GCS backup (CR-11). Installed by deploy/vm-setup.sh:
#   sudo cp deploy/systemd/valuegraph-backup.* /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now valuegraph-backup.timer
# Logs: journalctl -u valuegraph-backup.service
[Unit]
Description=ValueGraph nightly Postgres backup to GCS
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
# Set the bucket for your project (matches deploy/provision.sh BUCKET):
Environment=BACKUP_BUCKET=gs://CHANGE_ME-backups
WorkingDirectory=/opt/value-graph
ExecStart=/opt/value-graph/deploy/backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
