# ============================================================================
# env/data-keys.env — data-source API keys (fill the ones you have; blanks are OK)
# Copy to env/data-keys.env. Each source degrades gracefully when its key is unset
# (the feature stays dark / falls back), so start with the free KR/US keys.
# ============================================================================

# --- KR disclosures (OpenDART, free) ---------------------------------------
OPENDART_API_KEY=
# Multiple keys (comma-separated): a key over its daily 사용한도(020) is parked until
# the KST-midnight reset and requests rotate to the next. Falls back to the single key.
# OPENDART_API_KEYS=key1,key2,key3

# --- KR macro (Bank of Korea ECOS, free) -----------------------------------
ECOS_API_KEY=

# --- US macro (FRED, free) — auto-falls back to keyless DBnomics if unset ---
FRED_API_KEY=
# US labor/price indicators (BLS): keyless works (25/day); a free key raises it to 500/day.
BLS_API_KEY=

# --- Financial Modeling Prep (commercial) — consensus estimates + logos -----
FMP_API_KEY=
# Logo.dev — OPTIONAL publishable token (pk_…) for higher-quality company logos.
LOGODEV_TOKEN=

# --- Real-time company news (Google News RSS is the keyless fallback) -------
# Finnhub — US company news (free tier 60 req/min, real-time). https://finnhub.io
FINNHUB_API_KEY=
# Naver Search Open API — KR company news (native, free ~25k/day). Register a search app at
# https://developers.naver.com → Client ID + Secret. Unset → KR news falls back to Google News.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- News / transcripts -----------------------------------------------------
# NYT Archive (free) — pre-2017 era news (dot-com, GFC). Unset → GDELT(2017+) only.
NYT_API_KEY=
# API Ninjas (PREMIUM) — the earnings-call transcript source (US+KR, ~5y depth) + logos.
# REQUIRED for the transcript_text pipeline; unset → earnings-call transcripts stay dark.
API_NINJAS_KEY=

# --- KR market data (KRX account + KIS) -------------------------------------
# KRX login (data.krx.co.kr) — pykrx needs it for market-cap ranks / board membership
# (KOSPI200·KOSDAQ150). Unset → OpenDART corp-list fallback (lower KR universe quality).
KRX_ID=
KRX_PW=
# Korea Investment & Securities (KIS) — KR realtime rankings + investor flows.
KIS_APP_KEY=
KIS_APP_SECRET=
# KIS_DOMAIN=https://openapi.koreainvestment.com:9443   # 실전(default); 모의 = openapivts:29443

# --- GCP Document AI — parse 8-K presentation decks (PDF) into RAG ----------
# Create a Layout Parser processor, grant the SA roles/documentai.apiUser, point ADC at
# ./secrets/gcp-sa.json (the same SA the reranker uses). Unset → the deck feature stays dark.
DOCAI_PROJECT=
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=

# --- GCP Vertex reranker (optional; RAG_RERANKER_BACKEND=gcp in app.env) ----
# RAG_GCP_PROJECT=your-project-id
# RAG_GCP_LOCATION=global
# RAG_RERANKER_MODEL=semantic-ranker-default@latest
