# ============================================================================
# env/secrets.env — generated production secrets (NOT provider keys)
# Copy to env/secrets.env. The dev defaults below work locally; on a real deploy
# (ENV=production in env/app.env) services REFUSE to start on the dev defaults —
# generate fresh values for each.
# ============================================================================

# openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me
# trust token between the web BFF and studio-api (random string)
SERVICE_TOKEN=dev-service-token
# control-plane / studio admin token (random string)
ADMIN_TOKEN=dev-admin-token

# --- admin panel (:8005) login ---------------------------------------------
ADMINUI_USERNAME=admin
ADMINUI_PASSWORD=admin
ADMINUI_SECRET=dev-adminui-secret-change-me

# --- guest funnel + billing encryption (set in production) ------------------
# GUEST_IP_SALT=change-me
# BILLING_ENC_KEY=   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- NOT in this file, but also guarded in production (SC-0) -----------------
# • The default Postgres password rag:rag (in docker-compose.yml / your DATABASE_URL,
#   RAG_DATABASE_URL, POSTGRES_PASSWORD) — services refuse to start on rag:rag@ under ENV=production.
# • DATASETS_API_KEYS (env/data-keys.env) must be set with AUTH_DISABLED=false — otherwise
#   the data plane accepts any non-empty key. datasets refuses to boot open.
