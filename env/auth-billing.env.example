# ============================================================================
# env/auth-billing.env — social login · email OTP · Toss billing · alert channels
# Copy to env/auth-billing.env. All OPTIONAL for local dev (AUTH_DEV_LOGIN=true in
# env/app.env lets you log in with any email). Fill for production.
# ============================================================================

# --- Social sign-in (Auth.js) — each provider turns on when ID+SECRET are set
# Redirect/callback URI: {origin}/api/auth/callback/{google|kakao}
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# KakaoTalk — developers.kakao.com → REST API 키 / 보안(Client Secret), Kakao Login on.
# AUTH_KAKAO_ID=
# AUTH_KAKAO_SECRET=

# --- Email OTP login (Resend) — unset → dev mode (code printed to studio-api log)
# RESEND_API_KEY=
# EMAIL_FROM=ValueGraph <login@yourdomain.com>

# --- 토스페이먼츠 billing — unset TOSS_SECRET_KEY → FakeGateway (local) --------
# TOSS_SECRET_KEY=
# NEXT_PUBLIC_TOSS_CLIENT_KEY=
# TOSS_WEBHOOK_PATH_SECRET=   # random URL segment; register /api/billing/webhook/{this} in the Toss console

# --- Notification channel platform fallbacks (per-user creds are stored server-side)
# Used only if a user hasn't linked their own channel. No creds → deliveries are "simulated".
# TELEGRAM_BOT_TOKEN=
# SLACK_WEBHOOK_URL=
# KAKAO_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
