# ============================================================================
# env/app.env — app behaviour, feature flags, model tiers, universe, tuning knobs
# Copy to env/app.env. These are the defaults you rarely change — keys live in the
# other env/ files. Comments MUST stay on their own lines (compose parses inline
# "# ..." into the value, which would e.g. make AUTH_DEV_LOGIN != "true").
# ============================================================================

# --- deployment ------------------------------------------------------------
# Set ENV=production on a live deploy. Every service then REFUSES to start on a
# known dev-default secret (SC-0): AUTH_SECRET · SERVICE_TOKEN · ADMIN_TOKEN ·
# ADMINUI_USERNAME/PASSWORD/SECRET · GUEST_IP_SALT (when guests on) · BILLING_ENC_KEY
# (when Toss on) · the default pg password (rag:rag) — and datasets additionally needs
# DATASETS_API_KEYS set with AUTH_DISABLED=false. web dev-login is hard-disabled by
# NODE_ENV. Generate fresh values in env/secrets.env before flipping this on.
# ENV=production
LOG_LEVEL=INFO
# Public base URL share links point at (OG pages at {PUBLIC_BASE_URL}/s/{token}).
PUBLIC_BASE_URL=http://localhost:3000

# --- auth ------------------------------------------------------------------
# Log in with any email locally (no Google needed). Unset for production.
AUTH_DEV_LOGIN=true
# Behind the gateway the data plane trusts the caller (control plane is the auth).
# In production this MUST be false with DATASETS_API_KEYS set — datasets refuses to
# boot wide open (SC-0/CR-10).
AUTH_DISABLED=true

# --- data plane: providers -------------------------------------------------
SEC_EDGAR_USER_AGENT=ValueGraph Datasets contact@example.com
# prices: auto = fallback chain (US Yahoo→Stooq; KR Yahoo→KIS when KIS keys set). Pin to disable.
PRICES_PROVIDER_US=auto
PRICES_PROVIDER_KR=auto
# macro: auto falls back to keyless DBnomics (BIS rates) when FRED is bot-walled. auto|fred|dbnomics
MACRO_PROVIDER_US=auto

# --- agent model tiers (Gemini ids) ----------------------------------------
# stub (deterministic, no key) | gemini (real LLM, needs GOOGLE_API_KEY in env/gemini.env)
AGENT_LLM_BACKEND=stub
AGENT_MODEL=gemini-flash-latest
AGENT_BUDGET_MODEL=gemini-flash-lite-latest
AGENT_SYNTHESIS_MODEL=gemini-pro-latest
AGENT_REASONING_MODEL=gemini-flash-latest

# --- quality eval (eval/run_eval.py) ---------------------------------------
EVAL_JUDGE_MODEL=gemini-pro-latest
EVAL_JUDGE_BAR=3.8
EVAL_JUDGE_VOTES=2

# --- ingestion universe + history ------------------------------------------
SCHEDULER_UNIVERSE=us_sp500,kr_kospi200,kr_kosdaq150
# eval/test/e2e: use the tiny FIXED universe (US3·KR3) — SCHEDULER_UNIVERSE=eval_us,eval_kr
PRICES_BACKFILL_YEARS=10
HISTORY_UNIVERSE=^GSPC,^IXIC,^DJI,^VIX,^KS11,^KQ11,^TNX,^N225,^HSI,GC=F,CL=F,KRW=X
HISTORY_BACKFILL_START=1920-01-01
RAG_URL=http://rag:8002
NEWS_INGEST_LIMIT=8
# Per-key OpenDART daily limit (free = 20,000) — the admin quota panel's denominator.
OPENDART_DAILY_LIMIT=20000

# --- feature flags (chat-first: dashboard/alerts default OFF) ---------------
FEATURE_GUEST=false
FEATURE_DASHBOARD=false
FEATURE_ALERTS=false
BILLING_ENABLED=false
ASK_FEED_ENABLED=true

# --- plans / quota / guest (M-PROD) ----------------------------------------
# GUEST_TURNS_MAX=3
# GUEST_TURNS_PER_IP_DAY=10
# PLANS_JSON={"free": {"daily_turns": 10}, "pro": {"monthly_turns": 300}}
# PLAN_ENFORCE_CONNECTORS=false
# PLAN_RATE_LIMITS_JSON={"guest": 240, "free": 60, "pro": 240}
# PLAN_PRICE_PRO_KRW=19900
# REFERRAL_KICKBACK_MONTHLY_CAP_KRW=100000

# --- RAG (embeddings / vector store / reranker) ----------------------------
RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_EMBEDDING_DIM=1536            # 768 | 1536 | 3072
RAG_VECTOR_STORE=pgvector         # pgvector (persistent) | memory (dev)
RAG_RERANKER_BACKEND=none         # none | gcp (Vertex Ranking; keys in env/data-keys.env)
# ING-1: embed sub-batches concurrently; =1 restores sequential (rollback knob).
RAG_EMBED_CONCURRENCY=4
RAG_EMBED_BATCH=64
# ING-1: RAG-ingest client read budget = min(base + per_doc × docs, max).
RAG_INGEST_TIMEOUT_BASE_SECONDS=120
RAG_INGEST_TIMEOUT_PER_DOC_SECONDS=6
RAG_INGEST_TIMEOUT_MAX_SECONDS=1200

# --- timeouts / rate / cache ------------------------------------------------
CACHE_TTL_SECONDS=900
HTTP_TIMEOUT_SECONDS=30
# Gateway budget for RAG-bound requests only (semantic search embeds via a model API).
RAG_HTTP_TIMEOUT_SECONDS=90
RATE_LIMIT_PER_MINUTE=120

# --- alerts / desk / ask feed (seconds) ------------------------------------
ALERTS_SCHEDULER_ENABLED=true
ALERTS_TICK_SECONDS=60
DESK_FEED_TTL_SECONDS=2700
ASK_FEED_REFRESH_SECONDS=300
ASK_FEED_TICKER_TTL_SECONDS=1800
ASK_FEED_GENERATE_TIMEOUT_SECONDS=45

# --- cost dashboard (/costs) — operator-editable pricing --------------------
# PRICING_JSON={"as_of":"2026-07-10","rules":[{"match":"flash","in":0.30,"out":2.50},{"match":"pro","in":1.25,"out":10.0},{"match":"gemini-embedding","in":0.15,"out":0}]}
# FIXED_COSTS_JSON={"FMP Starter":{"usd":29,"note":"consensus estimates + calendar"}}

# --- infra (compose sets DATABASE_URL per-service; override only off-compose)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname
# REDIS_URL=redis://...
